# DepthWizard — environment configuration
#
# Copy to .env and fill in what you need. .env is gitignored and never committed.
# The core pipeline runs with NONE of these set: no key is required to produce a DSM
# from a local image, and the viewer is offline by design (hard rule 6).

# --------------------------------------------------------------------- SRTM access
# Terrain source for the absolute-height path. One of two routes — see docs/06-decisions.md O4.
#
# OpenTopography API key. Free, requires registration at opentopography.org.
# Leave blank to use the direct-tile route instead.
OPENTOPOGRAPHY_API_KEY=

# Where SRTM tiles are cached. Cached tiles keep the pipeline offline after first fetch.
SRTM_CACHE_DIR=data/srtm

# --------------------------------------------------------------------- data paths
# GAMUS root, containing images/ heights/ classes/ each split into train/ val/ test/.
# ~80 GB. Nothing under data/ is ever committed.
GAMUS_ROOT=data/gamus

# Model weights and checkpoints.
WEIGHTS_DIR=data/weights

# Sample imagery for manual testing, including any real ISRO scenes.
SAMPLES_DIR=data/samples

# --------------------------------------------------------------------- model
# Depth Anything V2 checkpoint. Pin an exact identifier — "latest" is not a provenance,
# and every DSM records which weights produced it (hard rule 3).
# Leave blank until Phase 0 pins it; see U-03 in docs/10-unsourced.md.
DEPTH_BACKBONE_ID=
DEPTH_BACKBONE_SHA256=

# Force a device. Leave blank to autodetect.
# NOTE: torch must be the CUDA build for this to do anything — see D-01 in docs/11-deferred.md.
TORCH_DEVICE=

# --------------------------------------------------------------------- server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
VIEWER_PORT=5173

# Largest input raster accepted, in megapixels. Guards against a 50000x50000 TIFF
# taking the process down mid-demo ("software stability" is in the evaluation criteria).
MAX_INPUT_MEGAPIXELS=400

# --------------------------------------------------------------------- training
# Used by server/train/. Must run unchanged locally and on a cloud GPU (docs/06-decisions.md D4),
# so keep machine-specific values here rather than in code.
TRAIN_BATCH_SIZE=4
TRAIN_TILE_SIZE=512
TRAIN_NUM_WORKERS=4
